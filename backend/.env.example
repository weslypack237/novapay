APP_NAME=NovaPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=novapay
DB_USERNAME=novapay
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@novapay.local
MAIL_FROM_NAME="${APP_NAME}"

NOVAPAY_DEMO_MODE=true
NOVAPAY_USD_ENABLED=false
NOVAPAY_TOKEN_TTL=720

# Provider placeholders — real values live in a secret manager, never in git.
KYC_PROVIDER=
KYC_API_BASE_URL=
KYC_API_KEY=
CARD_ISSUER_PROVIDER=
CARD_ISSUER_API_BASE_URL=
CARD_ISSUER_API_KEY=
MTN_PROVIDER=
MTN_API_BASE_URL=
MTN_API_KEY=
ORANGE_PROVIDER=
ORANGE_API_BASE_URL=
ORANGE_API_KEY=
FX_PROVIDER=
FX_API_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
